python3 -m venv .venv
source .venv/bin/activate
pip install -r requirements.txt

export MONGO_URL="mongodb://localhost:27017/emidb"
python3 app.py

k8s/ (Namespace, headless Service mongo, StatefulSet mongo, Job mongo-init, ConfigMap emi-config, Deployment emi-web, and ClusterIP Service emi-web).

